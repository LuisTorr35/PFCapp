root = true

[*]
charset = utf-8
insert_final_newline = true

[*.{kt,kts}]
# Estilo de Android Studio en lugar del oficial de ktlint, que es más estricto.
ktlint_code_style = android_studio
max_line_length = 140
# Las funciones @Composable se nombran con mayúscula inicial, como es estándar en Compose.
ktlint_function_naming_ignore_when_annotated_with = Composable
# El paquete com.example.pfc_app viene de la plantilla del proyecto y no se renombra.
ktlint_standard_package-name = disabled
