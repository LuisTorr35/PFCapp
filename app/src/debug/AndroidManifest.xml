<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/configuracion_red_depuracion">
        <!-- Solo en debug: órdenes por adb para verificar el respaldo. El permiso DUMP lo tiene
             adb (shell), no las demás apps. -->
        <receiver
            android:name=".depuracion.ReceptorDepuracion"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.pfc_app.ESTADO_RESPALDO" />
                <action android:name="com.example.pfc_app.LISTAR_NUBE" />
                <action android:name="com.example.pfc_app.USAR_EMULADOR" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
